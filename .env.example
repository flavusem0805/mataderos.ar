# Configuración de Supabase — solo servidor (sin prefijo NEXT_PUBLIC_)
# Cargar en Vercel -> Settings -> Environment Variables
SUPABASE_URL=
# Project Settings -> API Keys -> Publishable key (también acepta SUPABASE_ANON_KEY)
SUPABASE_PUBLISHABLE_KEY=
# Project Settings -> API Keys -> Secret key (también acepta SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=

# Dominio activo y persistencia de /sumate en Supabase
ROOT_DOMAIN=mataderos.ar
SUMATE_DB_ENABLED=true
