# Configuración de Supabase (cargar en Vercel -> Settings -> Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (nunca exponer con NEXT_PUBLIC_): se usa en /api/sumate y futuras tareas admin
SUPABASE_SERVICE_ROLE_KEY=

# Dominio activo y persistencia de /sumate en Supabase
NEXT_PUBLIC_ROOT_DOMAIN=mataderos.ar
NEXT_PUBLIC_SITE_URL=https://mataderos.ar
NEXT_PUBLIC_SUMATE_DB_ENABLED=true
